# Copy this file to .env and fill in real values before running docker-compose.
# .env is git-ignored — never commit secrets.

# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-base64-encoded-secret

# Shared key that internal services (e.g. parser-service) use to call /internal/** endpoints.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=replace-with-a-strong-internal-api-key

# --- Production HTTPS deployment (Traefik `production` profile) only ---
# Public domain that resolves to the deployment host. Required for the production profile.
TRAEFIK_DOMAIN=app.example.com
# Contact email used for ACME (Let's Encrypt) certificate registration and expiry notices.
TRAEFIK_ACME_EMAIL=ops@example.com
