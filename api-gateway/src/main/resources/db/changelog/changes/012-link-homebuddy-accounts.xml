<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="012-link-homebuddy-accounts" author="api-gateway">
        <addColumn tableName="users">
            <column name="account_id" type="UUID"/>
        </addColumn>
        <addUniqueConstraint tableName="users" columnNames="account_id"
                             constraintName="uk_users_account_id"/>
        <dropNotNullConstraint tableName="users" columnName="password_hash"
                               columnDataType="VARCHAR(255)"/>

        <rollback>
            <dropUniqueConstraint tableName="users" constraintName="uk_users_account_id"/>
            <dropColumn tableName="users" columnName="account_id"/>
            <update tableName="users">
                <column name="password_hash" value="!"/>
                <where>password_hash IS NULL</where>
            </update>
            <addNotNullConstraint tableName="users" columnName="password_hash"
                                  columnDataType="VARCHAR(255)"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
