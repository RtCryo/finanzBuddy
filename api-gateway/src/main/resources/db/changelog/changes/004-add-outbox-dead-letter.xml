<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="004-add-outbox-dead-letter" author="api-gateway">
        <addColumn tableName="outbox_events">
            <column name="dead_lettered_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>

        <dropIndex tableName="outbox_events" indexName="idx_outbox_events_unpublished"/>
        <createIndex tableName="outbox_events" indexName="idx_outbox_events_unpublished">
            <column name="published_at"/>
            <column name="dead_lettered_at"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
