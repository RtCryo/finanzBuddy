<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-add-deduplication-outcome" author="parser-service">
        <addColumn tableName="processed_documents">
            <column name="saved_count" type="INTEGER">
                <constraints nullable="true"/>
            </column>
            <column name="skipped_count" type="INTEGER">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <createIndex indexName="idx_transactions_user_booking_date" tableName="transactions">
            <column name="user_id"/>
            <column name="booking_date"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_transactions_user_booking_date" tableName="transactions"/>
            <dropColumn tableName="processed_documents" columnName="skipped_count"/>
            <dropColumn tableName="processed_documents" columnName="saved_count"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
