<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-transactions-table" author="parser-service">
        <createTable tableName="transactions">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="document_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="booking_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="value_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="amount" type="DECIMAL(19,4)">
                <constraints nullable="true"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="true"/>
            </column>
            <column name="counterparty" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="category" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="raw_data" type="JSONB">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_transactions_document_id" tableName="transactions">
            <column name="document_id"/>
        </createIndex>

        <createIndex indexName="idx_transactions_user_id" tableName="transactions">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
